# Server-only. Keyed RPC (e.g. Helius devnet). Never prefix it with NEXT_PUBLIC_:
# the browser reaches Solana only through /api/rpc, which reads this on the server.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Public: the Vetowall config the console shows. Defaults to the live devnet demo (vUSD).
NEXT_PUBLIC_VETOWALL_CONFIG=BQodWY1t1CVVJHpGdR9UnDg3wY3gyTsBDne5y2hSfTgp

# Optional, server-only: guardian service base URL; /api/decisions proxies GET $GUARDIAN_URL/decisions.
# Unset, the Guardian page shows labelled sample decisions.
GUARDIAN_URL=
