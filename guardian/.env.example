# Copy to .env (git-ignored). `npm start` loads it with node --env-file-if-exists.
RPC_URL=https://api.devnet.solana.com
# Optional; defaults to RPC_URL with ws(s)://
WS_URL=wss://api.devnet.solana.com
PROGRAM_ID=G8LSBa3y5XqY5fK4R6NTK84oPru3W3hsNzRwjunLWedr
# The Vetowall Config account this guardian protects (required). This one is the live devnet demo (vUSD).
CONFIG=BQodWY1t1CVVJHpGdR9UnDg3wY3gyTsBDne5y2hSfTgp
# Solana CLI keypair JSON of the key set as Config.guardian. Required by `npm start`.
# Leave it commented out for `npm run dry-run`: a path set here is read even in a dry run.
#GUARDIAN_KEYPAIR=/path/to/guardian-keypair.json
GUARDIAN_LOG=./decisions.jsonl
PORT=8787
# Optional: Claude writes the explanation; otherwise a fixed template does.
ANTHROPIC_API_KEY=

# Tuning (defaults shown)
POLL_MS=15000
# Veto a mint above this multiple of the trailing 7-day average mint
MINT_MULTIPLE=10
# Veto any single mint above this many whole tokens
MINT_CEILING_TOKENS=1000000000
