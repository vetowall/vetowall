            "type": "pubkey"
          },
          {
            "name": "proposer",
            "docs": [
              "The only key that may queue proposals, normally a Squads vault PDA."
            ],
            "type": "pubkey"
          },
          {
            "name": "guardian",
            "docs": [
              "May veto proposals and run `Safe` instructions. Nothing else."
            ],
            "type": "pubkey"
          },
